# 复制为 .env 后按需修改；docker compose 会自动读取
# 宿主机发布端口（验证环境已通过 CC_PUBLISH_PORT 注入，必须保持该变量名）
CC_PUBLISH_PORT=3084

# PostgreSQL（仅在 compose 内部网络使用，不发布到宿主）
POSTGRES_DB=portdb
POSTGRES_USER=portuser
POSTGRES_PASSWORD=portpass123

# JWT 签名密钥（生产环境务必更换，长度 >= 32 字节）
JWT_SECRET=port-inspection-demo-secret-key-0123456789abcdef

# 模拟海关系统处理时延（秒），用于演示“海关系统延迟”场景
CUSTOMS_DELAY_SECONDS=3

# 是否初始化演示数据（true/false）
SEED_DEMO_DATA=true
